# Copy to worker/.env (never commit it). These values are only read by the
# worker on your machine or server. Never place them in browser code.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase server-side SECRET key (starts with sb_secret_). Bypasses row level
# security, so keep it server-side only.
SUPABASE_SECRET_KEY=

# Browserless API token from your Browserless account dashboard.
BROWSERLESS_TOKEN=
# Regional endpoint: production-sfo, production-lon, or production-ams.
BROWSERLESS_ENDPOINT=wss://production-sfo.browserless.io
# Hard server-side cap per browser session. Free plan maximum is 120000 (2 min).
BROWSERLESS_SESSION_TIMEOUT_MS=110000
# Your plan's price per unit, used only for the cost ESTIMATE.
# Prototyping overage = 0.0020, Starter = 0.0017. Free plan units are prepaid (1k/month).
BROWSERLESS_UNIT_PRICE_USD=0.002

# Fixed per-run ceilings. The run stops before starting a session that could exceed either.
MAX_RUN_UNITS=150
MAX_RUN_COST_USD=1.00

# Politeness and timing
RATE_LIMIT_MS=4000
PAGE_TIMEOUT_MS=30000
MAX_PLP_CANDIDATES=3
JOB_STALE_MINUTES=30

# Which site list to run
SITES_FILE=config/spike-sites.json

# ---------------------------------------------------------------------------
# Phase 1 analysis (npm run analyse). Uses SUPABASE_URL and SUPABASE_SECRET_KEY above.
# ---------------------------------------------------------------------------

# Anthropic API key. Only required for --live runs; dry runs never call the model.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
MODEL_TIMEOUT_MS=180000

# Model IDs and official per-million-token prices (USD). Update if pricing changes.
ANALYST_MODEL=claude-sonnet-5-5
ANALYST_INPUT_USD_PER_MTOK=2
ANALYST_OUTPUT_USD_PER_MTOK=10
ANALYST_MAX_OUTPUT_TOKENS=12000
VERIFIER_MODEL=claude-sonnet-5-5
VERIFIER_INPUT_USD_PER_MTOK=2
VERIFIER_OUTPUT_USD_PER_MTOK=10
VERIFIER_MAX_OUTPUT_TOKENS=4000

# Per-run budget. Each call is refused before it is sent if its worst-case cost
# (counted input x (1 + margin) plus max output) would push the run over budget.
ANALYSIS_BUDGET_USD=2.5
ANALYSIS_INPUT_COUNT_MARGIN=0.1

# Evidence limits
ANALYSIS_MAX_IMAGES=40
ANALYSIS_MAX_SECTIONS_PER_PAGE=4
ANALYSIS_MAX_PAGE_TEXT_CHARS=6000
VERIFIER_MAX_IMAGES=8
