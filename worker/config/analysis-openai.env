# Pilot profile: GPT-6 Sol analyst + GPT-6 Sol verifier. Model choices only; API keys stay in .env.
# Verify the model ID and prices on OpenAI's official pricing page before a live run.
ANALYST_PROVIDER=openai
ANALYST_MODEL=gpt-6-sol
ANALYST_SERVICE_TIER=default
ANALYST_INPUT_USD_PER_MTOK=2
ANALYST_OUTPUT_USD_PER_MTOK=10
ANALYST_MAX_OUTPUT_TOKENS=12000
# Images are already prepared at <=1568 px long edge; "high" reads them at that resolution without going to maximum.
ANALYST_IMAGE_DETAIL=high
# Reasoning tokens count toward the output limit; leave unset to use the model default.
# ANALYST_REASONING_EFFORT=medium

VERIFIER_PROVIDER=openai
VERIFIER_MODEL=gpt-6-sol
VERIFIER_SERVICE_TIER=default
VERIFIER_INPUT_USD_PER_MTOK=2
VERIFIER_OUTPUT_USD_PER_MTOK=10
VERIFIER_MAX_OUTPUT_TOKENS=4000
VERIFIER_IMAGE_DETAIL=high
# VERIFIER_REASONING_EFFORT=medium
